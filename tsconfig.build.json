{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,

    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "build.ts"]
}
